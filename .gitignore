# Dependencies
node_modules/

# Local-only dev & migration tooling (never needed on the VPS)…
scripts/*
# …except the watchdog — it runs on the VPS as a pm2 app
!scripts/watchdog.js
!scripts/check-sheets.js

# Raw member data exports (contain real phone numbers — keep local only)
*.xlsx
*.xls
*.csv

# Local-only migration scripts (contain real member data — never commit)
migrate.js

# Bot secrets & auth (per-instance — never commit these)
bots/*/baileys_auth/
bots/*/.env
bots/*/service-account.json
bots/*/qr-payment.jpg
bots/*/trial-image.jpeg
bots/*/trial-video.mp4

# Per-bot runtime state (transient, contains member phone numbers — keep local only)
bots/*/reminder-state.json
bots/*/overdue-state.json
bots/*/removal-state.json

# Logs
logs/
*.log

# CRG graph (local dev tool — not needed on VPS)
.code-review-graph/
docs/

# Checkpoint / progress files (local only)
GOAL.md
PHASES.md
PROGRESS.md
PROGRESS_ARCHIVE.md
.learn-pending

# Setup guides (local reference only — contains server paths)
NEW_BOT_SETUP.md
TELEGRAM_MIGRATION.md

# OS & editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# PM2 local files
.pm2/

# Temp
*.tmp
*.bak
