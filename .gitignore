# Dependencies
node_modules/

# Local-only dev & migration tooling (never needed on the VPS)…
scripts/*
# …except the watchdog — it runs on the VPS as a pm2 app
!scripts/watchdog.js
!scripts/check-sheets.js
# Ledger tooling: reads configs, writes formulas. No member data passes through either.
!scripts/setup-ledger-sheet.js
!scripts/ledger-backfill.js
# QR variant maker — must run ON the VPS, because the QR images it reads are gitignored and
# so never arrive by deploy.
!scripts/make-qr-variants.js

# Raw member data exports (contain real phone numbers — keep local only)
*.xlsx
*.xls
*.csv

# Local-only migration scripts (contain real member data — never commit)
migrate.js

# Bot secrets & auth (per-instance — never commit these)
bots/*/baileys_auth/
bots/*/.env
bots/*/service-account.json
bots/*/qr-payment.jpg
# The rotated copies from scripts/make-qr-variants.js. Same reason as the original: this
# repo is public and the image has the UPI ID printed on it. Regenerate them on the VPS.
bots/*/qr-[0-9].jpg
bots/*/qr-[0-9][0-9].jpg
bots/*/trial-image.jpeg
bots/*/trial-video.mp4

# Per-bot runtime state (transient, contains member phone numbers — keep local only)
bots/*/reminder-state.json
# Which members already have this cycle's QR (real phone numbers)
bots/*/qr-sent.json
# Root-level too: tests used botDir '.', so a suite run wrote real reminder state
# (including a member's phone) into the repo and it got committed once already.
reminder-state.json
drip-state.json
bots/*/overdue-state.json
bots/*/removal-state.json
# Invite links, written by the bot itself (refreshlinks/setlink). Committing them would put
# the cache back under deploy, which is exactly what moving it out of config.json avoided.
bots/*/links.json
links.json

# Billing-date backups from scripts/reset-backlog.js (real names and phone numbers)
backups/

# Logs
logs/
*.log

# CRG graph (local dev tool — not needed on VPS)
.code-review-graph/
docs/

# Checkpoint / progress files (local only)
GOAL.md
PHASES.md
PROGRESS.md
PROGRESS_ARCHIVE.md
.learn-pending

# Setup guides (local reference only — contains server paths)
NEW_BOT_SETUP.md
TELEGRAM_MIGRATION.md

# OS & editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# PM2 local files
.pm2/

# Temp
*.tmp
*.bak
