# Copy to panel/.env (gitignored). The repo is public: real ids never go in git.

# bot=sheetId pairs, one per bot whose members the panel shows
PANEL_SHEETS=bot-nitin=<sheetId>,bot-abhi=<sheetId>,bot-sachin2=<sheetId>,bot-aayush2=<sheetId>
# Spreadsheet holding the ALL_NUMBERS tab (bot-nitin's sheet). Optional until Leads ship.
ALL_NUMBERS_SHEET=<sheetId>
# Same service account the bots use; path relative to panel/
SERVICE_ACCOUNT=service-account.json

# EaseCab member-sync API (same values as the bots' APP_SYNC_*)
APP_SYNC_URL=https://api.easecab.com
APP_SYNC_TOKEN=<token>

PANEL_PORT=8110
# First login: this name + PANEL_PIN, then set a real password in the panel
PANEL_ADMIN_NAME=nitin
PANEL_PIN=<8+ chars>
